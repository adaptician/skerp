{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "skerp-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Skerp.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5000
    },
    {
      "name": "skerp-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "start:client"],
      "port": 4200
    }
  ]
}
