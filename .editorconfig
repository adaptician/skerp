# EditorConfig — universal baseline (https://editorconfig.org).
#
# This file carries only stack-agnostic whitespace/encoding rules that every
# editor enforces. Language- and framework-specific analyzer and code-style rules
# belong with the relevant technology — for .NET, in the project's
# Directory.Build.props and a project-level .editorconfig (see
# .agents/standards/technologies/c-sharp.md) — not here.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.md]
# Trailing whitespace is significant in Markdown (two spaces = hard line break).
trim_trailing_whitespace = false
